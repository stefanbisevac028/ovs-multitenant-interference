# Parametri ns-ovs-isolation skripti na serveru. lab.env server lab-a se samo cita (preko ../common.sh).

# A3: cpuset po tier1 kontejneru (ovs-1..3: ovsdb-server, ovs-vswitchd, agent).
# Prekidi redova kartice su na CPU 0-3 (4 RSS reda). SMT parovi su (n, n+8), pa su 8-11 braca
# IRQ jezgara; ranija dodela 8-9 za tenant 3 je delila fizicka jezgra 0-1 sa prekidima (recenzija K2).
A3_CPUS=("4,12" "5,13" "6,14")   # K2 (18. 11.): jedno fizicko jezgro po tenantu, van IRQ jezgara 0-3 i njihovih SMT parova 8-11
A3_PIN_SERVICES=0              # 1 = i servis tenanta (svcN) dobija isti cpuset

# A4: RPS maska na redu prijema uplink0 u netns ovs-N (podrazumevano isto sto i A3)
A4_RPS_CPUS=("4,12" "5,13" "6,14")
# A4b: alternativni raspored RPS jezgara, zadaje se spolja (npr. A4_RPS_OVERRIDE="8 9 11" =
# SMT parovi jezgara 0, 1 i 3 koja opsluzuju prekide redova kartice); cpuset ostaje A3_CPUS
[ -n "${A4_RPS_OVERRIDE:-}" ] && read -r -a A4_RPS_CPUS <<< "$A4_RPS_OVERRIDE"

# A1: veza bridge-a tenanta sa br-tier0: patch (jedan datapath prolaz) ili veth
A1_LINK="patch"

# Latency tok (trex_latency.py) i reflektor (scripts/lat_reflect.sh)
LAT_PORT=7
LAT_COOKIE_BASE=0x15a70000     # cookie pravila reflektora = baza + N
TREX_IPS=("10.10.10.11" "10.10.10.12" "10.10.10.13")   # trexN -> svcN (traffic-generator lab.env)

RESULTS_DIR="$NS_DIR/results/raw"
