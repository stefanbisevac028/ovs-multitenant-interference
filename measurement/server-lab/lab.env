# Zajednicka konfiguracija za server lab (tier0 OvS -> tier1 OvS u kontejnerima -> Docker servisi).
# Sve skripte u 1/2/3 folderima citaju ovaj fajl. Menjaj vrednosti ovde, pa ponovo
# pokreni "2 - Setup Lab/setup.sh" (OvS kontejneri) i "3 - Start Lab/start.sh" (servisi).

# --- tier0: glavni OvS na hostu (sistemski ovs-vswitchd) ---
PHY_IF="enp5s0np0"          # Netronome SmartNIC (nfp), 10G, direktno ka traffic-generator-u
T0_BRIDGE="br-tier0"
MTU=1500

# --- OvS image (za tier0 agenta i tier1 OvS kontejnere) ---
OVS_IMAGE="server-lab/ovs:latest"
T0_CONTAINER="ovs-tier0"    # odrzava br-tier0, SmartNIC port i pravila na hostu

# --- tier1: nezavisni OvS-ovi, svaki u svom Docker kontejneru (= svoj mrezni namespace) ---
# U kontejneru rade ovsdb-server i ovs-vswitchd kao procesi.
T1_COUNT=3                  # kontejneri ovs-1, ovs-2, ovs-3
T1_PREFIX="ovs-"            # ime kontejnera i namespace-a: ovs-1 ...
T1_BRIDGE_PREFIX="br0-"     # bridge u kontejneru: br0-1 ...
# veth tier0 <-> tier1: na hostu "t0-ovs-N" (port na br-tier0), u kontejneru "uplink0" (port na br0-N)

# --- OpenFlow pravila ---
# Pravila su u "2 - Setup Lab/flows.txt" i vaze za tier0 i sve tier1 bridge-ove.
# Agenti u kontejnerima ih primenjuju sami (i posle izmene fajla, za nekoliko sekundi).
AGENT_INTERVAL=5            # sekundi izmedju provera (veth-ovi, portovi, pravila)

# --- Servisi (Docker kontejneri) ---
# Format: "ime:tier1:ip"  (tier1 = broj OvS-a na koji se kontejner vezuje)
# Svi su u istoj L2 mrezi sa TRex-om (10.10.10.0/24), bez gateway-a.
SERVICES=(
    "svc1:1:10.10.10.101"
    "svc2:2:10.10.10.102"
    "svc3:3:10.10.10.103"
)
SERVICE_PREFIXLEN=24
SERVICE_IMAGE="nicolaka/netshoot:latest"   # alati za testiranje (iperf3, tcpdump, curl...)
SERVICE_CMD="iperf3 -s"                    # komanda servisa u kontejneru (podrazumevano iperf3 server)
