# Zajednicka konfiguracija za TRex + OvS lab (traffic-generator).
# Sve skripte u 1/2/3 folderima citaju ovaj fajl. Menjaj vrednosti ovde.

# --- Fizicka kartica i OvS ---
PHY_IF="enp1s0"            # Mellanox ConnectX (mlx4_en), 10G
OVS_BRIDGE="br-trex"
MTU=1500

# --- TRex image ---
TREX_VERSION="v3.06"
TREX_IMAGE="trex-lab:${TREX_VERSION}"

# --- TRex kontejneri ---
# Broj kontejnera = broj elemenata u TREX_IPS.
# Svaki kontejner dobija data interfejs eth1 vezan na OvS bridge.
CONTAINER_PREFIX="trex"                       # trex1, trex2, trex3
TREX_IPS=("10.10.10.11" "10.10.10.12" "10.10.10.13")
TREX_PREFIXLEN=24
# Nema gateway-a: traffic-generator je direktno povezan na server sa SmartNIC-om.
# TREX_DEST_IPS je, za svaki kontejner, IP servisa na serveru koji taj TRex gadja
# (ista L2 mreza kao TREX_IPS). TRex salje ARP za tu adresu i svi paketi idu na
# MAC adresu koju dobije. Servisi su u ~/server-lab na serveru (svc1-3 na ovs-1..3).
# (U TRex konfiguraciji se ovo polje zove default_gw, ali ovde je to sam servis.)
TREX_DEST_IPS=("10.10.10.101" "10.10.10.102" "10.10.10.103")   # trex1->svc1, trex2->svc2, trex3->svc3
# CPU (i3-9100F ima samo 4 jezgra, 0-3). Jezgro 0 je master/API za sve kontejnere.
# TRex trazi da DP (slanje) i RX jezgro budu razliciti, pa se RX rotira po
# DP jezgrima ostalih kontejnera. Za maksimalan protok koristi manje kontejnera.
TREX_CORES=(1 2 3)                            # DP jezgro po kontejneru
TREX_RX_CORES=(2 3 1)                         # RX/latency jezgro po kontejneru

# TRex API (JSON-RPC preko ZMQ), publikovan na hostu:
#   trexN: sync = TREX_RPC_BASE + (N-1)*10, async = sync - 1
#   trex1: 4501/4500, trex2: 4511/4510, trex3: 4521/4520
TREX_RPC_BASE=4501

# --- Hugepages (2 MB) ---
# TRex sa af_packet interfejsom ne koristi hugepages (radi i sa 0), pa se ne rezervisu.
# Ako zatreba (npr. DPDK kartica), postavi broj stranica; setup.sh ih rezervise (do restarta).
HUGEPAGES_2M=0
TREX_MEM_MB=1024           # limit_memory po kontejneru
